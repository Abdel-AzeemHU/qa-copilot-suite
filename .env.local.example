# --- QA Copilot Suite environment variables ---
# Copy to .env.local and fill in real values.

# ── Database ───────────────────────────────────────────────────────────────────
# Dev (SQLite — for local development only, not supported in production):
#   DATABASE_URL="file:./prisma/dev.db"
# Prod (Postgres — required for Railway / Render / Vercel):
#   DATABASE_URL="postgresql://user:pass@host:5432/dbname?sslmode=require"
#
# When using a connection pooler (PgBouncer, Railway, Supabase pooler):
#   Append ?pgbouncer=true to DATABASE_URL
#   Set DIRECT_URL to the direct (non-pooled) connection for Prisma migrations
# ✅ Local dev default — SQLite, zero extra setup:
DATABASE_URL="file:./prisma/dev.db"

# 🚀 Production (Postgres — Railway / Render / Vercel):
# DATABASE_URL="postgresql://user:pass@host:5432/qa_copilot?sslmode=require"
# DIRECT_URL="postgresql://user:pass@host:5432/qa_copilot?sslmode=require"

# ── Auth ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"

# Set to your production domain in production (e.g. https://yourapp.up.railway.app)
NEXTAUTH_URL="http://localhost:3000"

# ── Encryption ────────────────────────────────────────────────────────────────
# Server-side secret used to AES-256-GCM encrypt user-provided API keys at rest.
# Must be at least 16 characters. Generate with: openssl rand -base64 32
ENCRYPTION_KEY="replace-me-with-a-long-random-string"

# ── App ────────────────────────────────────────────────────────────────────────
# Public base URL — used for invite links, OG tags, etc.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# NOTE: Users supply their own Claude API key through the app UI; it is stored
# encrypted in the ApiKey table. Do NOT put a Claude API key here.
