// Prisma schema for QA Copilot Suite (Phase 1)
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())

  organizations Organization[]
  apiKeys       ApiKey[]

  // NextAuth relations
  accounts Account[]
  sessions Session[]
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  createdAt DateTime @default(now())

  owner    User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  projects Project[]

  @@index([ownerId])
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  orgId       String
  createdAt   DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  testCases    TestCase[]

  automationRuns AutomationRun[]
  testPlans      TestPlan[]
  bugReports     BugReport[]
  staticReviews  StaticReview[]
  chatMessages   ChatMessage[]
  executionRuns  ExecutionRun[]
  integrations   Integration[]

  @@index([orgId])
}

model Integration {
  id              String    @id @default(cuid())
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type            String // "slack" | "github" | "webhook"
  name            String // user-friendly label
  config          String // JSON-encoded non-secret config (e.g. {"channel": "#qa", "repo": "org/repo"})
  encryptedSecret String? // encrypted webhook URL / API token (via lib/crypto encrypt())
  enabled         Boolean   @default(true)
  lastTriggeredAt DateTime?
  lastStatus      String? // "success" | "error" | null
  lastError       String?
  createdAt       DateTime  @default(now())

  @@index([projectId])
}

model ExecutionRun {
  id             String    @id @default(cuid())
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status         String    @default("queued") // queued | running | passed | failed | error
  targetUrl      String
  framework      String    @default("playwright")
  generatedCode  String // the automation code to run
  logs           String? // accumulated stdout/stderr
  result         String? // "passed" | "failed" | "error"
  errorMessage   String?
  screenshotPath String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  testCases      TestCase[] // which test cases this run covers

  healingAttempts HealingAttempt[] @relation("OriginalRun")
  verifiesAttempt HealingAttempt?  @relation("VerificationRun")
  bugReports      BugReport[]

  @@index([projectId])
}

model HealingAttempt {
  id              String    @id @default(cuid())
  executionRunId  String
  attemptNumber   Int
  classification  String // "repairable" | "likely_bug" | "inconclusive"
  diagnosis       String
  patchedCode     String?
  newRunId        String?   @unique
  status          String    @default("analyzing") // analyzing | patched | verifying | healed | failed_again | needs_review | error
  errorMessage    String?
  createdAt       DateTime  @default(now())
  completedAt     DateTime?

  executionRun ExecutionRun  @relation("OriginalRun", fields: [executionRunId], references: [id], onDelete: Cascade)
  newRun       ExecutionRun? @relation("VerificationRun", fields: [newRunId], references: [id], onDelete: SetNull)

  @@index([executionRunId])
}

model AutomationRun {
  id        String   @id @default(cuid())
  projectId String
  framework String
  language  String
  files     String // JSON-encoded Array<{ filename, language, content }>
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model TestPlan {
  id        String   @id @default(cuid())
  projectId String
  input     String // JSON
  output    String // JSON
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model BugReport {
  id             String   @id @default(cuid())
  projectId      String
  input          String // JSON
  output         String // JSON
  executionRunId String?
  createdAt      DateTime @default(now())

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  executionRun ExecutionRun? @relation(fields: [executionRunId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([executionRunId])
}

model StaticReview {
  id        String   @id @default(cuid())
  projectId String
  input     String // JSON
  output    String // JSON
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  projectId String
  role      String // "user" | "assistant"
  content   String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model TestCase {
  id             String   @id @default(cuid())
  projectId      String
  title          String
  preconditions  String?
  steps          String   @default("[]") // JSON-encoded string[]
  expectedResult String?
  priority       String   @default("medium") // high | medium | low
  type           String   @default("functional") // functional | edge | negative | performance | security
  requirement    String?
  targetUrl      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  executionRunId String?

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  executionRun ExecutionRun? @relation(fields: [executionRunId], references: [id], onDelete: SetNull)

  @@index([projectId])
}

model ApiKey {
  id           String   @id @default(cuid())
  userId       String
  provider     String // "claude" | "openai"
  encryptedKey String
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}

// --- NextAuth.js (Auth.js) Prisma adapter models ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
