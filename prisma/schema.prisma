// Prisma schema for QA Copilot Suite (Phase 1)
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  name           String?
  activeProvider String   @default("claude")
  createdAt      DateTime @default(now())

  organizations Organization[]
  apiKeys       ApiKey[]

  memberships     Membership[]
  invitationsSent Invitation[] @relation("InvitedBy")

  // NextAuth relations
  accounts Account[]
  sessions Session[]
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  createdAt DateTime @default(now())

  owner    User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  projects Project[]

  memberships Membership[]
  invitations Invitation[]

  @@index([ownerId])
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  orgId     String
  role      String // "owner" | "admin" | "member"
  createdAt DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
}

model Invitation {
  id          String    @id @default(cuid())
  orgId       String
  email       String
  role        String // "admin" | "member"
  token       String    @unique
  invitedById String
  status      String    @default("pending") // "pending" | "accepted" | "revoked"
  createdAt   DateTime  @default(now())
  acceptedAt  DateTime?
  expiresAt   DateTime

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([email])
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  orgId       String
  createdAt   DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  testCases    TestCase[]

  automationRuns AutomationRun[]
  testPlans      TestPlan[]
  bugReports     BugReport[]
  staticReviews  StaticReview[]
  chatMessages   ChatMessage[]
  executionRuns  ExecutionRun[]
  integrations   Integration[]
  pipelineRuns   PipelineRun[]
  parallelBatches ParallelBatch[]
  schedules      Schedule[]
  selectorCache  SelectorCache[]
  visualBaselines  VisualBaseline[]
  visualRuns       VisualRun[]
  apiTokens        ProjectApiToken[]
  flakinessReports FlakinessReport[]
  apiSpecs         ApiSpec[]

  @@index([orgId])
}

model ProjectApiToken {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String // e.g. "GitHub Actions CI"
  tokenPrefix String // first 8 chars, shown in UI for identification
  tokenHash   String   @unique // sha256 hash of the full token
  lastUsedAt  DateTime?
  createdById String
  expiresAt   DateTime? // optional expiry
  revokedAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([projectId])
  @@index([tokenHash])
}

model PipelineRun {
  id              String    @id @default(cuid())
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status          String    @default("queued") // queued | running | succeeded | failed | error
  targetUrl       String
  autoHeal        Boolean   @default(true)
  autoBug         Boolean   @default(true)
  notify          Boolean   @default(true)
  maxHealAttempts Int       @default(2)
  finalRunId      String?
  bugReportId     String?
  summary         String?
  errorMessage    String?
  ciMetadata      String?   // JSON: { ref, commit, prNumber, source: "github-actions" }
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())

  stages PipelineStage[]

  @@index([projectId])
}

model PipelineStage {
  id            String      @id @default(cuid())
  pipelineRunId String
  pipelineRun   PipelineRun @relation(fields: [pipelineRunId], references: [id], onDelete: Cascade)
  name          String // "execute" | "heal" | "bug" | "notify" | "report"
  sequence      Int
  status        String      @default("pending") // pending | running | succeeded | skipped | failed
  detail        String?
  startedAt     DateTime?
  completedAt   DateTime?

  @@index([pipelineRunId])
}

model Integration {
  id              String    @id @default(cuid())
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type            String // "slack" | "github" | "webhook"
  name            String // user-friendly label
  config          String // JSON-encoded non-secret config (e.g. {"channel": "#qa", "repo": "org/repo"})
  encryptedSecret String? // encrypted webhook URL / API token (via lib/crypto encrypt())
  enabled         Boolean   @default(true)
  lastTriggeredAt DateTime?
  lastStatus      String? // "success" | "error" | null
  lastError       String?
  createdAt       DateTime  @default(now())

  @@index([projectId])
}

model ExecutionRun {
  id             String    @id @default(cuid())
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status         String    @default("queued") // queued | running | passed | failed | error
  targetUrl      String
  framework      String    @default("playwright")
  generatedCode  String // the automation code to run
  logs           String? // accumulated stdout/stderr
  result         String? // "passed" | "failed" | "error"
  errorMessage   String?
  screenshotPath String?
  startedAt      DateTime?
  completedAt    DateTime?
  batchId        String?
  batch          ParallelBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())

  // Failure classification (set asynchronously after a failed/error run)
  failureClass           String? // real_bug | flaky | environment | automation
  failureClassConfidence String? // low | medium | high
  failureClassSummary    String? // one-paragraph AI explanation
  testCases      TestCase[] // which test cases this run covers

  healingAttempts HealingAttempt[] @relation("OriginalRun")
  verifiesAttempt HealingAttempt?  @relation("VerificationRun")
  bugReports      BugReport[]

  @@index([projectId])
}

model HealingAttempt {
  id              String    @id @default(cuid())
  executionRunId  String
  attemptNumber   Int
  classification  String // "repairable" | "likely_bug" | "inconclusive"
  diagnosis       String
  patchedCode     String?
  newRunId        String?   @unique
  status          String    @default("analyzing") // analyzing | patched | verifying | healed | failed_again | needs_review | error
  errorMessage    String?
  createdAt       DateTime  @default(now())
  completedAt     DateTime?

  executionRun ExecutionRun  @relation("OriginalRun", fields: [executionRunId], references: [id], onDelete: Cascade)
  newRun       ExecutionRun? @relation("VerificationRun", fields: [newRunId], references: [id], onDelete: SetNull)

  @@index([executionRunId])
}

model AutomationRun {
  id        String   @id @default(cuid())
  projectId String
  framework String
  language  String
  files     String // JSON-encoded Array<{ filename, language, content }>
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model TestPlan {
  id        String   @id @default(cuid())
  projectId String
  input     String // JSON
  output    String // JSON
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model BugReport {
  id             String   @id @default(cuid())
  projectId      String
  input          String // JSON
  output         String // JSON
  executionRunId String?
  createdAt      DateTime @default(now())

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  executionRun ExecutionRun? @relation(fields: [executionRunId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([executionRunId])
}

model StaticReview {
  id        String   @id @default(cuid())
  projectId String
  input     String // JSON
  output    String // JSON
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  projectId String
  role      String // "user" | "assistant"
  content   String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model TestCase {
  id             String   @id @default(cuid())
  projectId      String
  title          String
  preconditions  String?
  steps          String   @default("[]") // JSON-encoded string[]
  expectedResult String?
  priority       String   @default("medium") // high | medium | low
  type           String   @default("functional") // functional | edge | negative | performance | security
  requirement    String?
  targetUrl      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  executionRunId String?
  apiEndpointId  String?

  project          Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  executionRun     ExecutionRun?      @relation(fields: [executionRunId], references: [id], onDelete: SetNull)
  apiEndpoint      ApiEndpoint?       @relation(fields: [apiEndpointId], references: [id], onDelete: SetNull)
  flakinessReports FlakinessReport[]

  @@index([projectId])
}

model ApiSpec {
  id         String   @id @default(cuid())
  projectId  String
  name       String
  sourceType String // "openapi" | "postman"
  rawContent String
  baseUrl    String?
  createdAt  DateTime @default(now())

  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  endpoints ApiEndpoint[]

  @@index([projectId])
}

model ApiEndpoint {
  id          String  @id @default(cuid())
  apiSpecId   String
  method      String
  path        String
  operationId String?
  summary     String?
  description String?
  parameters  String  @default("[]") // JSON-encoded
  requestBody String? // JSON-encoded
  responses   String  @default("{}") // JSON-encoded
  tags        String  @default("[]") // JSON-encoded string[]

  apiSpec   ApiSpec    @relation(fields: [apiSpecId], references: [id], onDelete: Cascade)
  testCases TestCase[]

  @@index([apiSpecId])
}

model FlakinessReport {
  id             String    @id @default(cuid())
  projectId      String
  testCaseId     String?
  generatedCode  String
  targetUrl      String
  totalRuns      Int       @default(0)
  passCount      Int       @default(0)
  failCount      Int       @default(0)
  errorCount     Int       @default(0)
  status         String    @default("running") // running | stable | flaky | broken | error
  flakinessScore Float     @default(0) // 0 = stable, 1 = always failing
  quarantined    Boolean   @default(false)
  runIds         String    @default("[]") // JSON array of ExecutionRun ids
  rootCause      String?   // AI analysis
  suggestions    String?   // AI suggestions
  triggeredAt    DateTime  @default(now())
  completedAt    DateTime?

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testCase TestCase? @relation(fields: [testCaseId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([testCaseId])
}

model ApiKey {
  id           String   @id @default(cuid())
  userId       String
  provider     String // "claude" | "openai"
  encryptedKey String
  config       String? // JSON e.g. { "model": "gpt-4o-mini" }
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}

// --- NextAuth.js (Auth.js) Prisma adapter models ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ParallelBatch {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status      String   @default("running") // running | done | error
  createdAt   DateTime @default(now())
  completedAt DateTime?
  runs        ExecutionRun[]

  @@index([projectId])
}

model Schedule {
  id         String    @id @default(cuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name       String
  enabled    Boolean   @default(true)
  cronExpr   String
  targetUrl  String
  autoHeal   Boolean   @default(true)
  autoBug    Boolean   @default(true)
  notify     Boolean   @default(true)
  lastRunAt  DateTime?
  nextRunAt  DateTime?
  lastStatus String?
  createdAt  DateTime  @default(now())

  @@index([projectId])
  @@index([nextRunAt])
}

model SelectorCache {
  id               String   @id @default(cuid())
  projectId        String
  originalSelector String
  healedSelector   String
  strategy         String   // "testid" | "role" | "label" | "text" | "css"
  confidence       Float    @default(1.0)
  hitCount         Int      @default(1)
  lastUsedAt       DateTime @default(now())
  createdAt        DateTime @default(now())
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, originalSelector])
  @@index([projectId])
}

model VisualBaseline {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  url         String
  viewport    String
  imagePath   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  runs        VisualRun[]

  @@index([projectId])
}

model VisualRun {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  baselineId    String?
  baseline      VisualBaseline? @relation(fields: [baselineId], references: [id], onDelete: SetNull)
  status        String   @default("queued")
  url           String
  viewport      String
  imagePath     String?
  diffImagePath String?
  diffScore     Float?
  diffThreshold Float    @default(0.01)
  aiSeverity    String?
  aiSummary     String?
  aiIntentional Boolean?
  errorMessage  String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime @default(now())

  @@index([projectId])
  @@index([baselineId])
}

model AuditLog {
  id         String   @id @default(cuid())
  orgId      String?
  userId     String?
  action     String
  entityType String?
  entityId   String?
  meta       String?  // JSON
  ip         String?
  createdAt  DateTime @default(now())

  @@index([orgId])
  @@index([userId])
  @@index([createdAt])
}
